# Copy this file to ".env" and fill in your real values.
# .env is NEVER committed to the repo (see .gitignore).

# Local path to the Excel file that contains the "Invoices" table
EXCEL_PATH=C:\Users\YOUR_USER\Documents\InvoiceReport.xlsx

# Name of the table inside the Excel file (Insert > Table > name)
EXCEL_TABLE_NAME=Invoices

# Names of the columns inside the table (leave as-is if you didn't
# rename the headers in Excel)
COL_HEADER_DOCUMENT=DocumentNumber
COL_HEADER_DATE=Date
COL_HEADER_STATUS=Status
COL_HEADER_DAYS=DaysElapsed

# How many calendar days without authorization before a document is
# considered "stuck" (triggers an alert in the email)
DAYS_LIMIT_STUCK=20

# Email address that receives the alert draft
DESTINATION_EMAIL=your_email@yourcompany.com

# How often (in processed documents) progress is saved to the Excel file
SAVE_EVERY_N_DOCUMENTS=15

# ID of the favorite/folder node in the SAP tree that opens the
# approval report (found in the favorites tree of your SAP GUI session)
SAP_FAVORITE_NODE=F00000
